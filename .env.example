# Server & BFF Routing
NODE_ENV=development
PORT=3001

# Private VPC Internal ALB Target for shadify-api
INTERNAL_API_BASE_URL=http://internal-alb.vpc.local:8080

# Google Cloud Service Account Authentication (OIDC)
GCP_SA_KEY_PATH=/secrets/admin-web-sa-key.json
OIDC_TARGET_AUDIENCE=https://shadify-api-internal-bff

# Administrative Session Security
ADMIN_SESSION_SECRET=min-32-characters-secure-random-session-secret-here

